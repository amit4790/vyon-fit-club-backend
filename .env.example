# App settings
ENVIRONMENT=development
DEBUG=true
API_TITLE=VYON Fit Club Management API
API_VERSION=0.1.0
API_DESCRIPTION=Backend API for VYON Fit Club Management System
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vyonfitclub

# Device / Neon churn controls
DEVICE_PUSH_LOG_RAW=false
DEVICE_PERSIST_CDATA_TABLES=ATTLOG
DEVICE_PRESENCE_WRITE_INTERVAL_SECONDS=120
DEVICE_EMPTY_POLL_SKIP_SECONDS=0
ATTENDANCE_PUNCH_RETENTION_DAYS=90
DEVICE_RAW_LOG_RETENTION_DAYS=14

# Render Cron: POST /api/internal/cron/purge-attendance with header X-Cron-Secret
CRON_SECRET=
